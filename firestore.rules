rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function isAdmin(){ return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled != false; }
    match /admins/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if isAdmin(); }
    match /betaAllowlist/{email} { allow read: if signedIn() && request.auth.token.email == email; allow read, write: if isAdmin(); }
    match /users/{uid} { allow read: if signedIn() && (request.auth.uid == uid || isAdmin()); allow create: if signedIn() && request.auth.uid == uid; allow update: if signedIn() && (request.auth.uid == uid || isAdmin()); }
    match /accessCodes/{id} { allow read, write: if isAdmin(); }
    match /v13LoginSuccess/{uid} { allow read: if isAdmin(); allow create, update: if signedIn() && request.auth.uid == uid; }
    match /appSettings/systemAnnouncement { allow read: if true; allow create, update: if isAdmin(); }
    match /appSettings/{id} { allow read: if signedIn(); allow create, update: if signedIn() && id != 'systemAnnouncement'; }
  }
}
